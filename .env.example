# Server-only: Google Gemini API Key for serverless proxy (/api/gemini)
# Set in Vercel Environment Variables (Production + Preview) and local .env.
# NEVER add a VITE_ prefix (which would expose it to the browser bundle).
# If omitted or left blank, AuraPlan runs on its built-in 100% functional deterministic local engine.
GEMINI_API_KEY=
